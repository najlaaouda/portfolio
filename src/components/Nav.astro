---
import site from '../data/site.json';
const contactHref = site.contact.email ? `mailto:${site.contact.email}` : '/#contact';
const links = [
  ['Work', '/#work'],
  ['About', '/#about'],
  ['Services', '/#services'],
  ['Contact', '/#contact'],
];
---

<header class="nav">
  <div class="nav-inner">
    <a class="wordmark" href="/" aria-label={`${site.name}, home`}>
      <span class="mark">N</span>
      <span class="wm-text">najlaa<span class="dot">.</span></span>
    </a>
    <nav aria-label="Main">
      <ul>
        {links.map(([label, href]) => (
          <li>
            <a href={href}><span class="roll"><span data-text={label}>{label}</span></span></a>
          </li>
        ))}
      </ul>
    </nav>
    <div class="right">
      <a class="btn sm primary" href={contactHref} data-magnetic="0.3">Let's talk</a>
    </div>
  </div>
</header>

<script>
  // Hide on scroll down, show on scroll up
  const nav = document.querySelector<HTMLElement>('.nav')!;
  let last = scrollY;
  addEventListener('scroll', () => {
    const y = scrollY;
    nav.classList.toggle('hide', y > last && y > 240);
    nav.classList.toggle('solid', y > 40);
    last = y;
  }, { passive: true });
</script>

<style>
  .nav {
    position: fixed; top: 14px; left: 0; right: 0; z-index: 50;
    padding-inline: var(--gutter);
    transition: translate .6s var(--ease-out);
  }
  .nav.hide { translate: 0 calc(-100% - 20px); }
  .nav-inner {
    max-width: var(--max); margin: 0 auto;
    display: flex; align-items: center; justify-content: space-between; gap: 16px;
    padding: 8px 8px 8px 10px; border-radius: 999px;
    border: 1px solid transparent;
    transition: background .4s, border-color .4s, backdrop-filter .4s;
  }
  .nav.solid .nav-inner {
    background: color-mix(in srgb, var(--surface) 72%, transparent);
    border-color: color-mix(in srgb, var(--ink) 9%, transparent);
    backdrop-filter: blur(16px) saturate(1.4);
    -webkit-backdrop-filter: blur(16px) saturate(1.4);
  }
  .wordmark { display: inline-flex; align-items: center; gap: 10px; text-decoration: none; }
  .mark {
    display: grid; place-items: center; width: 38px; height: 38px; border-radius: 50%;
    background: var(--ink); color: var(--bg); font: 800 17px/1 var(--display);
    transition: rotate .6s var(--ease-out), background .3s;
  }
  .wordmark:hover .mark { rotate: 360deg; background: var(--accent); }
  .wm-text { font-family: var(--display); font-weight: 800; font-size: 20px; letter-spacing: -0.04em; }
  ul { list-style: none; display: flex; gap: 4px; margin: 0; padding: 4px; border-radius: 999px; background: color-mix(in srgb, var(--ink) 5%, transparent); }
  ul a { display: block; text-decoration: none; font-size: 14px; font-weight: 600; color: var(--muted); padding: 9px 16px; border-radius: 999px; transition: color .25s, background .25s; }
  ul a:hover { color: var(--ink); background: color-mix(in srgb, var(--ink) 8%, transparent); }
  /* Text rolls up to a copy of itself on hover */
  .roll { display: inline-block; overflow: hidden; vertical-align: top; line-height: 1.25; }
  .roll > span { position: relative; display: inline-block; transition: translate .5s var(--ease-out); }
  .roll > span::after { content: attr(data-text); position: absolute; left: 0; top: 100%; }
  ul a:hover .roll > span { translate: 0 -100%; }
  .right { display: flex; align-items: center; gap: 14px; }
  @media (max-width: 900px) { nav { display: none; } }
</style>
