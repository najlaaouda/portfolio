---
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const { title, summary, cover, year, tags, outcome, category } = project.data;
---

<a class="card reveal" href={`/work/${project.id}/`} data-tags={tags.join('|')} data-category={category}>
  <div class="shot">
    <img src={cover} alt={`${title} cover`} loading="lazy" decoding="async" width="1600" height="1100" />
    <span class="view">View case →</span>
  </div>
  {tags.length > 0 && (
    <div class="tags">{tags.map((t) => <span class="tag">{t}</span>)}</div>
  )}
  <div class="meta">
    <h3>{title}</h3>
    <span class="label">{year}</span>
  </div>
  <p>{summary}</p>
  {outcome && <p class="outcome"><span class="label">What changed</span>{outcome}</p>}
</a>

<style>
  .card { display: flex; flex-direction: column; gap: 14px; text-decoration: none; min-width: 0; }
  .shot { position: relative; aspect-ratio: 16 / 11; border-radius: var(--radius); overflow: hidden; background: var(--accent-soft); }
  .shot img { width: 100%; height: 100%; object-fit: cover; transition: transform .7s var(--ease); }
  .card:hover .shot img { transform: scale(1.04); }
  .view {
    position: absolute; right: 16px; bottom: 16px;
    background: var(--ink); color: var(--bg);
    font-size: 13px; font-weight: 600; padding: 9px 15px; border-radius: 999px;
    opacity: 0; transform: translateY(6px); transition: opacity .3s, transform .3s var(--ease);
  }
  .card:hover .view, .card:focus-visible .view { opacity: 1; transform: none; }
  .meta { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; }
  h3 { font-size: 24px; font-weight: 700; }
  p { color: var(--muted); font-size: 15px; }
  .outcome { display: flex; flex-direction: column; gap: 4px; color: var(--ink); font-weight: 500; padding-top: 12px; border-top: 1px dashed var(--line); }
</style>
