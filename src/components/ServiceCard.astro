---
// Service card with a small "specimen" that shows the kind of work, not an icon.
interface Props {
  service: {
    label: string;
    specimen: string;
    title: string;
    text: string;
    deliverables: string[];
  };
}

const { service } = Astro.props;
---

<article data-spot class:list={['service reveal', { wide: service.specimen === 'ai' || service.specimen === 'ds' }]}>
  <div class="top">
    <span class="label">{service.label}</span>
    {service.specimen === 'ai' && <span class="new">New</span>}
  </div>

  <div class="specimen" aria-hidden="true">
    {service.specimen === 'ai' && (
      <div class="ai">
        <div class="ai-step">
          <span class="label">01 · Brief</span>
          <b>Goals, flows and content</b>
        </div>
        <span class="arrow">→</span>
        <div class="ai-step">
          <span class="label">02 · Claude + my skills</span>
          <b class="prompt">“Design the dashboard from this brief”<i class="caret"></i></b>
        </div>
        <span class="arrow">→</span>
        <div class="ai-step human">
          <span class="label">03 · Designer review</span>
          <b>Refine in Figma ✓</b>
        </div>
      </div>
    )}
    {service.specimen === 'ds' && (
      <div class="ds">
        <div class="variants">
          <span class="label">Button / variants</span>
          <div class="vrow"><span class="vb primary">Primary</span><span class="vb">Secondary</span><span class="vb ghost">Ghost</span></div>
          <div class="vrow"><span class="vb primary hover">Hover</span><span class="vb hover">Hover</span><span class="vb ghost disabled">Disabled</span></div>
        </div>
        <div class="doc">
          <span class="label">Docs · Button</span>
          <b>When to use</b>
          <p>One primary button per screen, for the main action. Use secondary for everything else.</p>
          <div class="tok"><span>radius/md · 12</span><span>space/3 · 12</span><span>color/primary</span></div>
        </div>
      </div>
    )}
    {service.specimen === 'flow' && (
      <div class="flow">
        <span class="node">Open app</span>
        <span class="arrow">→</span>
        <span class="node diamond">Logged in?</span>
        <span class="arrow">→</span>
        <span class="node accent">Home</span>
      </div>
    )}
    {service.specimen === 'ui' && (
      <div class="ui">
        <div class="tokens">
          <span><i style="background: var(--accent)"></i>Primary</span>
          <span><b>Aa</b>Display 700</span>
          <span><em></em>Radius 16</span>
        </div>
        <div class="mini-btns">
          <span class="mb primary">Continue</span>
          <span class="mb">Cancel</span>
        </div>
      </div>
    )}
    {service.specimen === 'code' && (
      <pre class="code"><code><span class="t">&lt;ProjectCard</span>
  <span class="a">title</span>=<span class="s">"Shipping App"</span>
  <span class="a">tags</span>=&#123;[<span class="s">"UX"</span>, <span class="s">"UI"</span>]&#125;
<span class="t">/&gt;</span></code></pre>
    )}
    {service.specimen === 'motion' && (
      <div class="motion">
        <svg viewBox="0 0 200 80" preserveAspectRatio="none">
          <path d="M0 78 C 60 78, 70 2, 200 2" fill="none" stroke="currentColor" stroke-width="2" />
        </svg>
        <div class="ticks"><span>0ms</span><span>180</span><span>360ms</span></div>
      </div>
    )}
  </div>

  <h3>{service.title}</h3>
  <p>{service.text}</p>
  <ul class="checks">
    {service.deliverables.map((d) => <li>{d}</li>)}
  </ul>
</article>

<style>
  .service {
    display: flex; flex-direction: column; gap: 16px;
    padding: 28px; border: 1px solid var(--line); border-radius: var(--radius);
    background: var(--surface); min-width: 0;
    transition: border-color .3s, transform .4s var(--ease);
  }
  .service:hover { border-color: var(--accent); transform: translateY(-4px); }
  .top { display: flex; justify-content: space-between; align-items: center; }
  h3 { font-size: 26px; font-weight: 700; }
  p { color: var(--muted); font-size: 16px; }

  .specimen {
    background: var(--bg); border: 1px dashed var(--line); border-radius: 14px;
    min-height: 132px; padding: 18px; display: grid; place-items: center; overflow: hidden;
  }

  .service.wide { grid-column: 1 / -1; }
  .wide .checks { display: grid; grid-template-columns: repeat(2, 1fr); gap: 8px 24px; }
  .new { font-size: 12px; font-weight: 700; padding: 4px 10px; border-radius: 999px; background: var(--accent); color: var(--on-accent); }

  .ai { width: 100%; display: grid; grid-template-columns: 1fr auto 1.4fr auto 1fr; gap: 12px; align-items: center; }
  .ai-step { display: flex; flex-direction: column; gap: 6px; padding: 14px 16px; border-radius: 12px; background: var(--surface); border: 1px solid var(--line); min-width: 0; }
  .ai-step b { font-size: 14px; font-weight: 600; }
  .ai-step .prompt { font-family: var(--mono); font-size: 12.5px; font-weight: 500; }
  .ai-step.human { background: var(--accent); border-color: var(--accent); color: var(--on-accent); }
  .ai-step.human .label { color: var(--on-accent); opacity: .7; }
  .caret { display: inline-block; width: 7px; height: 14px; margin-left: 3px; vertical-align: -2px; background: var(--accent); animation: blink 1s steps(1) infinite; }
  @keyframes blink { 50% { opacity: 0; } }

  @media (max-width: 860px) {
    .ai { grid-template-columns: 1fr; }
    .ai .arrow { transform: rotate(90deg); justify-self: center; }
    .wide .checks { grid-template-columns: 1fr; }
  }

  .ds { width: 100%; display: grid; grid-template-columns: 1fr 1.2fr; gap: 14px; align-items: stretch; }
  .variants, .doc { display: flex; flex-direction: column; gap: 10px; padding: 14px 16px; border-radius: 12px; background: var(--surface); border: 1px solid var(--line); min-width: 0; }
  .vrow { display: flex; gap: 8px; flex-wrap: wrap; }
  .vb { font-size: 12px; font-weight: 600; padding: 7px 12px; border-radius: 10px; border: 1px solid var(--ink); }
  .vb.primary { background: var(--accent); border-color: var(--accent); color: var(--on-accent); }
  .vb.primary.hover { background: var(--ink); border-color: var(--ink); color: var(--bg); }
  .vb.hover { background: var(--accent-soft); }
  .vb.ghost { border-color: transparent; text-decoration: underline; text-underline-offset: 3px; }
  .vb.disabled { opacity: .4; }
  .doc b { font-size: 14px; }
  .doc p { font-size: 13px; color: var(--muted); }
  .tok { display: flex; flex-wrap: wrap; gap: 6px; }
  .tok span { font-family: var(--mono); font-size: 10.5px; padding: 4px 8px; border-radius: 6px; background: var(--accent-soft); }
  @media (max-width: 860px) { .ds { grid-template-columns: 1fr; } }

  .flow { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; justify-content: center; font-size: 13px; font-weight: 600; }
  .node { padding: 8px 12px; border-radius: 10px; background: var(--surface); border: 1px solid var(--line); }
  .node.diamond { border-style: dashed; border-color: var(--accent); }
  .node.accent { background: var(--accent); border-color: var(--accent); color: var(--on-accent); }
  .arrow { color: var(--muted); }

  .ui { display: flex; flex-direction: column; gap: 14px; width: 100%; }
  .tokens { display: flex; gap: 8px; flex-wrap: wrap; font-family: var(--mono); font-size: 11px; color: var(--muted); }
  .tokens span { display: inline-flex; align-items: center; gap: 6px; padding: 6px 10px; border: 1px solid var(--line); border-radius: 8px; background: var(--surface); }
  .tokens i { width: 12px; height: 12px; border-radius: 50%; display: block; }
  .tokens b { font-family: var(--display); color: var(--ink); font-size: 13px; }
  .tokens em { width: 12px; height: 12px; border-radius: 4px; border: 2px solid var(--ink); display: block; }
  .mini-btns { display: flex; gap: 8px; }
  .mb { font-size: 13px; font-weight: 600; padding: 9px 16px; border-radius: 999px; border: 1px solid var(--ink); }
  .mb.primary { background: var(--accent); border-color: var(--accent); color: var(--on-accent); }

  .code { margin: 0; width: 100%; font-family: var(--mono); font-size: 12.5px; line-height: 1.7; color: var(--ink); white-space: pre; overflow-x: auto; }
  .code .t { color: var(--accent-ink); font-weight: 600; }
  .code .a { color: var(--muted); }
  .code .s { color: var(--ink); }

  .motion { width: 100%; color: var(--accent); display: flex; flex-direction: column; gap: 8px; }
  .motion svg { width: 100%; height: 72px; }
  .ticks { display: flex; justify-content: space-between; font-family: var(--mono); font-size: 11px; color: var(--muted); }

  .checks { list-style: none; margin: 0; padding: 16px 0 0; border-top: 1px solid var(--line); display: flex; flex-direction: column; gap: 8px; font-size: 15px; }
  .checks li { display: flex; gap: 10px; align-items: baseline; }
  .checks li::before { content: "✓"; color: var(--accent-ink); font-weight: 700; font-size: 13px; }
</style>
