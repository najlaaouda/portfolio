---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import site from '../data/site.json';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  /** Show the counting preloader (homepage, once per session) */
  intro?: boolean;
}

const { title, description = site.heroText, image, intro = false } = Astro.props;
const pageTitle = title ? `${title} · ${site.name}` : `${site.name} · ${site.role}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#080808" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    {image && <meta property="og:image" content={new URL(image, Astro.site)} />}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&family=Instrument+Serif:ital@0;1&family=JetBrains+Mono:wght@400;500&family=IBM+Plex+Sans+Arabic:wght@400;500;700&display=swap"
    />
    <script is:inline define:vars={{ intro }}>
      const d = document.documentElement;
      d.classList.add('js');
      let seen = false;
      try { seen = sessionStorage.getItem('intro') === '1'; } catch {}
      if (intro && !seen && !matchMedia('(prefers-reduced-motion: reduce)').matches) d.classList.add('intro');
    </script>
  </head>
  <body>
    {intro && (
      <div class="loader" aria-hidden="true">
        <div class="loader-top">
          <span>{site.name}</span>
          <span>Portfolio ©{new Date().getFullYear()}</span>
        </div>
        <div class="loader-count"><b>0</b><i>%</i></div>
        <div class="loader-bar"><i></i></div>
      </div>
    )}
    <div class="progress" aria-hidden="true"></div>
    <div class="cursor" aria-hidden="true"><span>View</span></div>
    <div class="cursor-dot" aria-hidden="true"></div>
    <Nav />
    <main>
      <slot />
    </main>
    <Footer />
    <script>
      const root = document.documentElement;
      const still = matchMedia('(prefers-reduced-motion: reduce)').matches;

      // Split [data-split] text into masked words (keeps <em> and <br>)
      let wi = 0;
      const splitNode = (node: Node) => {
        [...node.childNodes].forEach((child) => {
          if (child.nodeType === 3) {
            const frag = document.createDocumentFragment();
            (child.textContent ?? '').split(/(\s+)/).forEach((part) => {
              if (!part) return;
              if (/^\s+$/.test(part)) return frag.append(' ');
              const w = document.createElement('span');
              w.className = 'w';
              w.innerHTML = `<span style="--wi:${wi++}"></span>`;
              (w.firstChild as HTMLElement).textContent = part;
              frag.append(w);
            });
            child.replaceWith(frag);
          } else if (child.nodeType === 1 && (child as Element).tagName !== 'BR') splitNode(child);
        });
      };
      document.querySelectorAll('[data-split]').forEach((el) => { wi = 0; splitNode(el); });

      // Reveal on scroll
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
          }
        },
        { rootMargin: '0px 0px -8% 0px' }
      );
      const watch = () => document.querySelectorAll('.reveal, [data-split]').forEach((el) => io.observe(el));

      // Preloader: count to 100, then lift the curtain
      const loader = document.querySelector<HTMLElement>('.loader');
      if (loader && root.classList.contains('intro')) {
        const num = loader.querySelector('b')!;
        const start = performance.now();
        const tick = (now: number) => {
          const t = Math.min(1, (now - start) / 1600);
          const v = Math.round(100 * (1 - Math.pow(1 - t, 3)));
          num.textContent = String(v);
          loader.style.setProperty('--lp', String(v / 100));
          if (t < 1) return requestAnimationFrame(tick);
          root.classList.add('loaded');
          try { sessionStorage.setItem('intro', '1'); } catch {}
          setTimeout(() => { root.classList.remove('intro'); watch(); }, 650);
        };
        requestAnimationFrame(tick);
      } else {
        root.classList.add('loaded');
        watch();
      }

      // Scroll progress
      const bar = document.querySelector<HTMLElement>('.progress')!;
      const onScroll = () => {
        const max = document.documentElement.scrollHeight - innerHeight;
        bar.style.setProperty('--p', String(max > 0 ? scrollY / max : 0));
      };
      addEventListener('scroll', onScroll, { passive: true });
      onScroll();

      // Custom cursor + magnetic elements (fine pointers only)
      if (matchMedia('(hover: hover) and (pointer: fine)').matches && !still) {
        const ring = document.querySelector<HTMLElement>('.cursor')!;
        const dot = document.querySelector<HTMLElement>('.cursor-dot')!;
        let mx = innerWidth / 2, my = innerHeight / 2, rx = mx, ry = my;
        addEventListener('pointermove', (e) => {
          mx = e.clientX; my = e.clientY;
          ring.classList.add('on'); dot.classList.add('on');
          dot.style.transform = `translate(${mx}px, ${my}px)`;
        });
        const loop = () => {
          rx += (mx - rx) * 0.18; ry += (my - ry) * 0.18;
          ring.style.transform = `translate(${rx}px, ${ry}px)`;
          requestAnimationFrame(loop);
        };
        loop();
        document.addEventListener('pointerover', (e) => {
          const t = e.target as Element;
          ring.classList.toggle('view', !!t.closest('[data-cursor="view"]'));
          ring.classList.toggle('hover', !t.closest('[data-cursor="view"]') && !!t.closest('a, button'));
        });

        document.querySelectorAll<HTMLElement>('[data-magnetic]').forEach((el) => {
          const strength = Number(el.dataset.magnetic) || 0.35;
          el.style.transition = 'translate .6s cubic-bezier(.16,1,.3,1)';
          el.addEventListener('pointermove', (e) => {
            const r = el.getBoundingClientRect();
            const x = (e.clientX - r.left - r.width / 2) * strength;
            const y = (e.clientY - r.top - r.height / 2) * strength;
            el.style.translate = `${x}px ${y}px`;
          });
          el.addEventListener('pointerleave', () => (el.style.translate = '0 0'));
        });

        // Spotlight cards follow the pointer
        document.querySelectorAll<HTMLElement>('[data-spot]').forEach((el) => {
          el.addEventListener('pointermove', (e) => {
            const r = el.getBoundingClientRect();
            el.style.setProperty('--mx', `${e.clientX - r.left}px`);
            el.style.setProperty('--my', `${e.clientY - r.top}px`);
          });
        });
      }
    </script>
  </body>
</html>

<style is:global>
  .loader {
    position: fixed; inset: 0; z-index: 200; display: none; flex-direction: column; justify-content: space-between;
    padding: clamp(20px, 4vw, 48px); background: var(--accent); color: var(--on-accent);
  }
  .intro .loader { display: flex; }
  .intro body { overflow: hidden; }
  .loaded .loader { translate: 0 -100%; transition: translate 1s cubic-bezier(.76, 0, .24, 1) .1s; }
  .loader-top { display: flex; justify-content: space-between; font: 500 13px/1 var(--mono); text-transform: uppercase; letter-spacing: .08em; }
  .loader-count { display: flex; align-items: flex-start; font-family: var(--display); font-weight: 800; letter-spacing: -0.06em; line-height: .8; font-size: clamp(120px, 26vw, 360px); }
  .loader-count i { font-style: normal; font-size: .3em; margin-top: .1em; }
  .loader-bar { height: 2px; background: color-mix(in srgb, var(--on-accent) 20%, transparent); }
  .loader-bar i { display: block; height: 100%; background: var(--on-accent); transform-origin: 0 50%; scale: var(--lp, 0) 1; }
</style>
