---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found">
  <section class="section container wrap">
    <span class="label">404</span>
    <h1>This page wandered off<span class="dot">.</span></h1>
    <a class="btn primary" href="/">Back home</a>
  </section>
</Base>

<style>
  .wrap { display: flex; flex-direction: column; gap: 24px; align-items: flex-start; }
  h1 { font-size: clamp(44px, 8vw, 96px); font-weight: 800; letter-spacing: -0.04em; max-width: 14ch; }
</style>
