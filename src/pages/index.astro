---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import WorkPlate from '../components/WorkPlate.astro';
import ServiceCard from '../components/ServiceCard.astro';
import site from '../data/site.json';

const projects = (await getCollection('projects', ({ data }) => !data.draft && data.featured))
  .sort((a, b) => a.data.order - b.data.order || b.data.year - a.data.year)
  .slice(0, 6);

// Hero decks: three screens from each mobile project, cycled in the hero
const decks = (await getCollection('projects', ({ data }) => !data.draft && data.device === 'mobile' && data.showcase.length >= 3))
  .sort((a, b) => a.data.order - b.data.order)
  .map((p) => ({ slug: p.id, title: p.data.title, brand: p.data.brand ?? '#E8B04B', screens: p.data.showcase.slice(0, 3) }));

const { contact } = site;
const whatsappHref = contact.whatsapp ? `https://wa.me/${contact.whatsapp.replace(/\D/g, '')}` : '';
const [first, last] = site.name.split(' ');
const years = new Date().getFullYear() - 2019;
const badge = 'Available for work ✦ Scroll down ✦ ';
const statementWords = site.statement.split(' ');
---

<Base intro>
  <!-- HERO -->
  <section class="hero" id="top">
    <div class="hero-meta container">
      {site.available && <span class="avail h-in" style="--hd: 0">{site.availableText}</span>}
      <span class="label h-in" style="--hd: 1">Based in Cairo · Working worldwide</span>
    </div>

    <h1 class="hero-name" aria-label={site.name}>
      <span class="nm">{[...first].map((c, i) => <span class="ch" style={`--ci: ${i}`}>{c}</span>)}</span>
      <span class="nm">{[...last].map((c, i) => <span class="ch" style={`--ci: ${i + first.length}`}>{c}</span>)}</span>
    </h1>

    <div class="hero-stage" style={decks[0] && `--brand: ${decks[0].brand}`}>
      <div class="halo" aria-hidden="true"></div>
      {decks.map((d, i) => (
        <a class:list={['deck', { on: i === 0 }]} href={`/work/${d.slug}/`} data-brand={d.brand} aria-label={`View ${d.title}`} inert={i !== 0} data-cursor="view">
          <img class="ph p1" src={d.screens[1]} alt="" width="390" height="844" decoding="async" />
          <img class="ph p2" src={d.screens[2]} alt="" width="390" height="844" decoding="async" />
          <img class="ph p0" src={d.screens[0]} alt={`${d.title}, home screen`} width="390" height="844" decoding="async" fetchpriority={i === 0 ? 'high' : undefined} />
        </a>
      ))}
      <span class="chip c1" aria-hidden="true"><i>✦</i> {site.role}</span>
      <span class="chip c2" aria-hidden="true">Figma × Claude</span>
      {site.reviews.length > 0 && (
        <span class="chip c3" aria-hidden="true"><b>★ {site.reviews[0].rating}</b> · {site.reviews[0].count} reviews</span>
      )}
    </div>

    <div class="hero-bottom container">
      <div class="hero-left h-in" style="--hd: 4">
        <p class="rot-line">
          I design
          <span class="rotator" aria-live="polite">
            {site.heroWords.map((w, i) => <span class:list={['rw', { on: i === 0 }]}>{w}</span>)}
          </span>
        </p>
        <p class="lead">{site.heroText}</p>
      </div>
      <div class="hero-right h-in" style="--hd: 5">
        <div class="ctas">
          <a class="btn primary" href="#work" data-magnetic>View my work <span class="arr">→</span></a>
          <a class="btn" href="#contact" data-magnetic>Let's talk</a>
        </div>
        <a class="badge" href="#work" aria-label="Scroll to work" data-magnetic="0.5">
          <svg viewBox="0 0 100 100" aria-hidden="true">
            <defs><path id="circ" d="M50,50 m-38,0 a38,38 0 1,1 76,0 a38,38 0 1,1 -76,0" /></defs>
            <text><textPath href="#circ" textLength="236" lengthAdjust="spacing">{badge}</textPath></text>
          </svg>
          <span class="badge-arrow" aria-hidden="true">↓</span>
        </a>
      </div>
    </div>
  </section>

  <!-- MARQUEE -->
  {site.marquee.length > 0 && (
    <div class="marquee" aria-hidden="true">
      <div class="mrow" data-speed="1">
        {[0, 1, 2].map(() => (
          <div class="group">{site.marquee.map((m, i) => <span class:list={{ out: i % 2 === 1 }}>{m}<i>✦</i></span>)}</div>
        ))}
      </div>
      <div class="mrow rev" data-speed="-1">
        {[0, 1, 2].map(() => (
          <div class="group">{site.stack.map((m) => <span class="sm">{m}<i>●</i></span>)}</div>
        ))}
      </div>
    </div>
  )}

  <!-- ABOUT -->
  <section id="about" class="section container">
    <span class="eyebrow">About me</span>
    <p class="statement" data-fill>
      {statementWords.map((w) => <span class="fw">{w} </span>)}
    </p>

    <ul class="stats">
      <li class="reveal"><b><span data-count={years}>0</span>+</b><span>Years in UX/UI</span></li>
      <li class="reveal"><b><span data-count="15">0</span>+</b><span>Apps & websites</span></li>
      {site.reviews.length > 0 && (
        <>
          <li class="reveal"><b><span data-count={site.reviews[0].count}>0</span>+</b><span>Client reviews</span></li>
          <li class="reveal">
            <b><span data-count={site.reviews[0].rating} data-decimals="1">0</span></b>
            <span class="stars" role="img" aria-label={`${site.reviews[0].rating} out of 5 stars`}>
              {[0, 1, 2, 3, 4].map((i) => <i style={`--d: ${i}`}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2.6l2.9 5.9 6.5.9-4.7 4.6 1.1 6.5L12 17.4l-5.8 3.1 1.1-6.5-4.7-4.6 6.5-.9z" /></svg></i>)}
            </span>
          </li>
        </>
      )}
    </ul>

    <div class="about">
      <div class="about-text">
        <h2 data-split>{site.aboutTitle} <em>& the person</em></h2>
        {site.about.map((para) => <p class="reveal">{para}</p>)}
        <ul class="facts reveal">
          {site.aboutFacts.map((f) => <li>{f}</li>)}
        </ul>
      </div>
      <div class="career">
        <h3 class="mini-title reveal">My career</h3>
        <ol class="timeline">
          {site.experience.map((job, i) => (
            <li class="reveal" style={`--i: ${i}`} data-spot>
              <span class="period">{job.period}</span>
              <h4>{job.role}</h4>
              <span class="company">{job.company}</span>
              <p>{job.text}</p>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <!-- WORK -->
  <section id="work" class="section container">
    <div class="section-head">
      <div class="head-text">
        <span class="eyebrow">Selected work · {String(projects.length).padStart(2, '0')}</span>
        <h2 data-split>Projects I'm <em>proud of</em></h2>
      </div>
      <a class="btn sm" href="/work/" data-magnetic>All projects <span class="arr">→</span></a>
    </div>
    {projects.length > 0 ? (
      <ol class="plates" style={`--n: ${projects.length}`}>
        {projects.map((p, i) => <WorkPlate project={p} index={i} total={projects.length} />)}
      </ol>
    ) : (
      <p class="empty">Projects are on their way.</p>
    )}
  </section>

  <!-- SERVICES -->
  <section id="services" class="section services-wrap">
    <div class="container">
      <div class="section-head">
        <div class="head-text">
          <span class="eyebrow">Services</span>
          <h2 data-split>How I can <em>help you</em></h2>
        </div>
      </div>
      <div class="services">
        {site.services.map((s) => <ServiceCard service={s} />)}
      </div>
      {site.servicesNote && (
        <div class="services-note reveal">
          <p>{site.servicesNote}</p>
          <a class="btn primary" href="#contact" data-magnetic>Start a project <span class="arr">→</span></a>
        </div>
      )}
    </div>
  </section>

  <!-- PROCESS -->
  <section class="section container">
    <div class="section-head">
      <div class="head-text">
        <span class="eyebrow">Process</span>
        <h2 data-split>How I <em>work</em></h2>
      </div>
    </div>
    <ol class="process">
      {site.process.map((step, i) => (
        <li class="reveal" style={`--i: ${i}`} data-spot>
          <span class="num">{String(i + 1).padStart(2, '0')}</span>
          <h3>{step.title}</h3>
          <p>{step.text}</p>
          <ul class="outputs">
            {step.outputs.map((o) => <li>{o}</li>)}
          </ul>
        </li>
      ))}
    </ol>
  </section>

  <!-- TESTIMONIALS -->
  {site.testimonials.length > 0 && (
    <section id="testimonials" class="section testimonials">
      <div class="container section-head">
        <div class="head-text">
          <span class="eyebrow">Testimonials</span>
          <h2 data-split>Why clients <em>trust me</em></h2>
        </div>
      </div>
      <div class="qtrack-wrap">
        <div class="qtrack">
          {[0, 1].map((copy) => (
            <div class="qgroup" aria-hidden={copy === 1 ? 'true' : undefined}>
              {site.testimonials.map((t: { quote: string; name: string; role?: string; lang?: string; rating?: number }) => (
                <figure class="quote">
                  <span class="stars sm" role="img" aria-label={`${t.rating ?? 5} out of 5 stars`}>
                    {Array.from({ length: t.rating ?? 5 }, () => <i><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2.6l2.9 5.9 6.5.9-4.7 4.6 1.1 6.5L12 17.4l-5.8 3.1 1.1-6.5-4.7-4.6 6.5-.9z" /></svg></i>)}
                  </span>
                  <blockquote lang={t.lang} dir={t.lang === 'ar' ? 'rtl' : undefined}>“{t.quote}”</blockquote>
                  <figcaption>
                    <span class="avatar" aria-hidden="true">{t.name.charAt(0)}</span>
                    <span class="who"><b>{t.name}</b>{t.role && <span>{t.role}</span>}</span>
                  </figcaption>
                </figure>
              ))}
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- CONTACT -->
  <section id="contact" class="section container contact">
    <span class="eyebrow">Contact</span>
    <h2 data-split>Let's create something <em>great</em> together</h2>
    <p class="lead reveal">{contact.text}</p>
    <div class="contact-row reveal">
      {contact.email && (
        <a class="big-btn" href={`mailto:${contact.email}`} data-magnetic="0.25">
          <span>Get in touch</span><span class="arr">↗</span>
        </a>
      )}
      <div class="contact-links">
        {contact.email && (
          <button class="mail" type="button" data-copy={contact.email}>
            <span class="mail-text">{contact.email}</span>
            <span class="mail-tip" data-tip>Copy</span>
          </button>
        )}
        <div class="ctas">
          {whatsappHref && <a class="btn" href={whatsappHref} target="_blank" rel="noopener" data-magnetic>WhatsApp</a>}
          {site.socials.linkedin && <a class="btn" href={site.socials.linkedin} target="_blank" rel="noopener" data-magnetic>LinkedIn</a>}
        </div>
      </div>
    </div>
  </section>
</Base>

<script>
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const clamp = (v: number, a = 0, b = 1) => Math.min(b, Math.max(a, v));
  const lerp = (a: number, b: number, t: number) => a + (b - a) * t;

  // Hero word rotator
  const words = [...document.querySelectorAll<HTMLElement>('.rw')];
  if (words.length > 1 && !reduce) {
    let w = 0;
    setInterval(() => {
      words[w].classList.replace('on', 'off');
      const prev = words[w];
      setTimeout(() => prev.classList.remove('off'), 700);
      w = (w + 1) % words.length;
      words[w].classList.add('on');
    }, 2200);
  }

  // Hero decks: cycle through projects, halo takes each project's brand colour
  const stage = document.querySelector<HTMLElement>('.hero-stage');
  const decks = [...document.querySelectorAll<HTMLElement>('.deck')];
  if (stage && decks.length > 1 && !reduce) {
    let d = 0, paused = false;
    stage.addEventListener('pointerenter', () => (paused = true));
    stage.addEventListener('pointerleave', () => (paused = false));
    setInterval(() => {
      if (paused || document.hidden || scrollY > innerHeight) return;
      // Current deck stays underneath while the next one wipes in over it
      const prev = decks[d];
      prev.classList.replace('on', 'prev');
      prev.inert = true;
      d = (d + 1) % decks.length;
      decks[d].classList.add('on');
      decks[d].inert = false;
      stage.style.setProperty('--brand', decks[d].dataset.brand ?? '');
      setTimeout(() => prev.classList.remove('prev'), 1700);
    }, 4200);
  }

  // Copy email
  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((b) =>
    b.addEventListener('click', async () => {
      const tip = b.querySelector<HTMLElement>('[data-tip]')!;
      try { await navigator.clipboard.writeText(b.dataset.copy ?? ''); tip.textContent = 'Copied ✓'; }
      catch { location.href = `mailto:${b.dataset.copy}`; }
      setTimeout(() => (tip.textContent = 'Copy'), 1800);
    })
  );

  // Count up once visible
  const fmt = (el: HTMLElement, v: number) => (el.textContent = v.toFixed(Number(el.dataset.decimals ?? 0)));
  const countUp = (el: HTMLElement) => {
    const end = Number(el.dataset.count);
    if (reduce) return fmt(el, end);
    const start = performance.now();
    const tick = (now: number) => {
      const t = Math.min(1, (now - start) / 1600);
      fmt(el, end * (1 - Math.pow(1 - t, 4)));
      if (t < 1) requestAnimationFrame(tick);
    };
    requestAnimationFrame(tick);
  };
  const counted = new IntersectionObserver(
    (entries) => entries.forEach((e) => {
      if (e.isIntersecting) { countUp(e.target as HTMLElement); counted.unobserve(e.target); }
    }),
    { threshold: 0.6 }
  );
  document.querySelectorAll<HTMLElement>('[data-count]').forEach((c) => counted.observe(c));

  // Plates: entrance trigger
  const plates = [...document.querySelectorAll<HTMLElement>('.plate')];
  plates.forEach((p) => p.setAttribute('data-cursor', 'view'));
  const seen = new IntersectionObserver(
    (entries) => entries.forEach((e) => {
      if (e.isIntersecting) { e.target.classList.add('in'); seen.unobserve(e.target); }
    }),
    { threshold: 0.25 }
  );
  plates.forEach((p) => seen.observe(p));

  if (!reduce) {
    const hero = document.querySelector<HTMLElement>('.hero')!;
    const photo = document.querySelector<HTMLElement>('.hero-stage')!;
    const fill = document.querySelector<HTMLElement>('[data-fill]');
    const fillWords = fill ? [...fill.querySelectorAll<HTMLElement>('.fw')] : [];
    const rows = [...document.querySelectorAll<HTMLElement>('.mrow')];
    const rowX = rows.map(() => 0);
    const list = plates[0]?.parentElement as HTMLElement | undefined;
    let lastY = scrollY, vel = 0;

    // Phones follow the pointer slightly
    let px = 0, py = 0, tx = 0, ty = 0;
    hero.addEventListener('pointermove', (e) => {
      tx = (e.clientX / innerWidth - 0.5) * 2;
      ty = (e.clientY / innerHeight - 0.5) * 2;
    });

    const frame = () => {
      const y = scrollY, vh = innerHeight;
      vel = lerp(vel, y - lastY, 0.12);
      lastY = y;

      // Hero parallax: name drifts up, phones sink and lean with the pointer
      const hp = clamp(y / vh);
      hero.style.setProperty('--hp', hp.toFixed(4));
      px = lerp(px, tx, 0.06); py = lerp(py, ty, 0.06);
      photo.style.setProperty('--px', px.toFixed(3));
      photo.style.setProperty('--py', py.toFixed(3));

      // Marquee: base speed plus scroll velocity, direction flips with scroll
      const boost = 1 + Math.min(8, Math.abs(vel) * 0.25);
      const dir = vel < -0.5 ? -1 : 1;
      rows.forEach((r, i) => {
        const w = (r.firstElementChild as HTMLElement).offsetWidth || 1;
        rowX[i] -= 0.6 * boost * dir * Number(r.dataset.speed);
        if (rowX[i] <= -w) rowX[i] += w;
        if (rowX[i] > 0) rowX[i] -= w;
        r.style.transform = `translate3d(${rowX[i]}px,0,0) skewX(${clamp(-vel * 0.15, -8, 8)}deg)`;
      });

      // Statement: words light up as it scrolls through the viewport
      if (fill) {
        const r = fill.getBoundingClientRect();
        const t = clamp((vh * 0.85 - r.top) / (r.height + vh * 0.35));
        const lit = Math.floor(t * fillWords.length * 1.05);
        fillWords.forEach((w, i) => w.classList.toggle('lit', i < lit));
      }

      // Plates: screen drift and stacked "recede"
      if (list && plates.length) {
        const stacked = getComputedStyle(plates[0]).position === 'sticky';
        const lr = list.getBoundingClientRect();
        const lp = clamp((vh - lr.top) / (lr.height + vh * 0.4));
        plates.forEach((p, i) => {
          const r = p.getBoundingClientRect();
          if (r.bottom < -vh || r.top > vh * 2) return;
          const t = stacked ? clamp(lp * plates.length - i + 0.35) : clamp((vh - r.top) / (vh + r.height));
          p.style.setProperty('--t', t.toFixed(4));
          p.style.setProperty('--ya', `${lerp(6, -16, t).toFixed(2)}%`);
          p.style.setProperty('--yb', `${lerp(-14, 4, t).toFixed(2)}%`);
          const next = plates[i + 1];
          if (stacked && next) {
            const cover = clamp(1 - (next.getBoundingClientRect().top - r.top) / r.height);
            p.style.setProperty('--s', (1 - 0.06 * cover).toFixed(4));
            p.style.setProperty('--dim', (0.4 * cover).toFixed(3));
          } else {
            p.style.removeProperty('--s');
            p.style.removeProperty('--dim');
          }
        });
      }
      requestAnimationFrame(frame);
    };
    requestAnimationFrame(frame);
  } else {
    document.querySelectorAll('.fw').forEach((w) => w.classList.add('lit'));
  }
</script>

<style>
  /* ---------- HERO ---------- */
  .hero {
    --hp: 0;
    position: relative; min-height: min(100svh, 1000px); overflow: clip;
    display: flex; flex-direction: column; margin-top: -84px; padding-top: 96px;
  }
  .hero::before {
    content: ""; position: absolute; inset: 0; z-index: -1; pointer-events: none;
    background:
      radial-gradient(60% 50% at 50% 70%, color-mix(in srgb, var(--accent) 16%, transparent), transparent 70%),
      linear-gradient(to right, color-mix(in srgb, var(--ink) 4%, transparent) 1px, transparent 1px) 0 0 / 80px 80px,
      linear-gradient(to bottom, color-mix(in srgb, var(--ink) 4%, transparent) 1px, transparent 1px) 0 0 / 80px 80px;
    mask-image: radial-gradient(ellipse at 50% 40%, #000 30%, transparent 75%);
  }
  .hero-meta { width: 100%; display: flex; justify-content: space-between; align-items: center; gap: 12px; flex-wrap: wrap; padding-top: 12px; }
  .avail { display: inline-flex; align-items: center; gap: 10px; font-size: 14px; font-weight: 600; padding: 8px 14px 8px 12px; border-radius: 999px; border: 1px solid var(--line); background: var(--surface); }
  .avail::before { content: ""; width: 8px; height: 8px; border-radius: 50%; background: #3BDC84; box-shadow: 0 0 0 0 #3BDC84; animation: ping 2s infinite; }
  @keyframes ping { 0% { box-shadow: 0 0 0 0 color-mix(in srgb, #3BDC84 60%, transparent); } 80%, 100% { box-shadow: 0 0 0 10px transparent; } }

  .hero-name {
    position: relative; z-index: 1;
    display: flex; justify-content: center; gap: .22em; white-space: nowrap;
    font-size: clamp(64px, 12.6vw, 230px); font-weight: 800; letter-spacing: -0.06em; line-height: .85;
    margin-top: clamp(24px, 4vh, 56px); text-align: center;
    translate: 0 calc(var(--hp) * -30vh); opacity: calc(1 - var(--hp) * 1.2);
  }
  .nm { display: inline-flex; overflow: clip; padding-bottom: .06em; }
  .nm:last-child { color: transparent; -webkit-text-stroke: 1.5px color-mix(in srgb, var(--ink) 55%, transparent); }
  .ch { display: inline-block; }
  .js .ch { translate: 0 105%; }
  .js.loaded .ch { translate: none; transition: translate 1.2s var(--ease-out) calc(.15s + var(--ci) * 45ms); }

  @property --brand { syntax: '<color>'; inherits: true; initial-value: #E8B04B; }
  .hero-stage {
    --px: 0; --py: 0;
    position: absolute; z-index: 2; left: 50%; bottom: 0;
    width: min(500px, 40vw); aspect-ratio: 540 / 600;
    translate: calc(-50% + var(--px) * 10px) calc(var(--hp) * 12vh);
    transition: --brand 1.6s ease;
  }
  /* Decks swap like a curtain: the next one is revealed from left to right over the current one */
  .deck {
    position: absolute; inset: 0; display: block; pointer-events: none; z-index: 1;
    -webkit-mask-image: linear-gradient(to top, transparent 0, #000 16%); mask-image: linear-gradient(to top, transparent 0, #000 16%);
    clip-path: inset(-20% 120% -20% -20%);
  }
  .deck.on { z-index: 2; pointer-events: auto; clip-path: inset(-20%); transition: clip-path 1.6s cubic-bezier(.65, 0, .35, 1); }
  .deck.prev { clip-path: inset(-20%); }
  .ph {
    position: absolute; aspect-ratio: 390 / 844; height: auto; object-fit: cover; object-position: top;
    border-radius: clamp(16px, 2.4vw, 34px); border: clamp(4px, .5vw, 7px) solid #0d0d0d; background: #0d0d0d;
    box-shadow: 0 30px 60px -18px rgb(0 0 0 / .75);
    transition: opacity .9s .25s, transform 1.2s var(--ease-out) .25s, --open .6s var(--ease-out);
  }
  .p1 { transition-delay: .35s, .35s, 0s; }
  .p2 { transition-delay: .45s, .45s, 0s; }
  @property --open { syntax: '<angle>'; inherits: false; initial-value: 0deg; }
  .js:not(.loaded) .ph { opacity: 0; transform: translateY(60px) scale(.96); }
  /* Float: the same lift and lean as the chips (bob), all three phones together */
  @property --bob { syntax: '<length>'; inherits: false; initial-value: 0px; }
  @property --tilt { syntax: '<angle>'; inherits: false; initial-value: 0deg; }
  @keyframes float { 50% { --bob: -10px; --tilt: -2deg; } }
  .ph { animation: float 5s ease-in-out infinite; }
  .p0 { z-index: 2; width: 46%; left: 27%; bottom: -8%; rotate: var(--tilt); translate: calc(var(--px) * 6px) calc(var(--py) * 4px + var(--bob)); }
  .p1 { width: 38%; left: 2%; bottom: 5%; rotate: calc(-9deg - var(--open) + var(--px) * 1.5deg + var(--tilt)); translate: calc(var(--px) * -14px) calc(var(--py) * -8px + var(--bob)); }
