---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { brandStyle, vtName, reelImages } from '../../lib/brand';

export async function getStaticPaths() {
  const projects = (await getCollection('projects', ({ data }) => !data.draft))
    .sort((a, b) => a.data.order - b.data.order || b.data.year - a.data.year);
  return projects.map((project, i) => ({
    params: { slug: project.id },
    props: { project, next: projects[(i + 1) % projects.length], index: i, total: projects.length },
  }));
}

interface Props {
  project: CollectionEntry<'projects'>;
  next: CollectionEntry<'projects'>;
  index: number;
  total: number;
}

const { project, next, index, total } = Astro.props;
const { Content } = await render(project);
const d = project.data;
const vt = vtName(project.id);
const pad = (n: number) => String(n).padStart(2, '0');

// Five phones hanging off the hero band (three on mobile)
// Screen kind from its file name: mobile-*, tablet-*, otherwise the project's device
const kind = (src: string) =>
  src.includes('/mobile-') ? 'm' : src.includes('/tablet-') ? 't' : d.device === 'web' ? 'w' : 'm';
const heroShots = reelImages(d.showcase, d.screens).slice(0, 5);
// Web projects: a browser window in the middle with phones beside it
const heroWeb = d.device === "web" ? d.screens.flatMap((g) => g.images).find((s) => kind(s) === "w") : undefined;
const heroPhones = d.device === "web" ? d.screens.flatMap((g) => g.images).filter((s) => kind(s) === "m").slice(0, 2) : [];
const screenCount = d.screens.reduce((n, g) => n + g.images.length, 0);

const meta = [
  ['Role', d.role],
  ['Year', String(d.year)],
  ['Timeline', d.timeline],
  ['Platform', d.platform],
  ['Tools', d.tools.join(' · ')],
  ['Screens', screenCount ? String(screenCount) : undefined],
].filter(([, v]) => v);

const links = [
  ['Prototype', d.links.prototype],
  ['Figma', d.links.figma],
  ['Behance', d.links.behance],
  ['Live site', d.links.live],
].filter(([, v]) => v);

// Running index across all gallery screens, for the lightbox counter
let n = 0;
const groups = d.screens.map((g) => ({ ...g, items: g.images.map((src) => ({ src, i: n++ })) }));
---

<Base title={d.title} description={d.summary} image={d.cover}>
  <article style={brandStyle(d.brand)}>
    <!-- HERO BAND -->
    <header class="container hero">
      <div class="band" style={`view-transition-name: plate-${vt}`}></div>
      <div class="band-content">
        <a class="label back" href="/#work">← Back to work</a>
        <span class="label">[ Case study / {pad(index + 1)} of {pad(total)} ]</span>
        <h1><span style={`view-transition-name: title-${vt}`}>{d.title}</span></h1>
        <p class="summary">{d.summary}</p>
        {d.tags.length > 0 && <ul class="btags">{d.tags.map((t) => <li>{t}</li>)}</ul>}
      </div>
      {heroWeb ? (
        <div class="hang web" aria-hidden="true">
          {heroPhones[0] && <img class="hp" src={heroPhones[0]} alt="" width="390" height="844" style="--k: 1" />}
          <div class="hb" style="--k: 0">
            <div class="hb-bar"><i></i><i></i><i></i></div>
            <img src={heroWeb} alt="" width="1440" height="900" />
          </div>
          {heroPhones[1] && <img class="hp" src={heroPhones[1]} alt="" width="390" height="844" style="--k: 2" />}
        </div>
      ) : heroShots.length > 0 ? (
        <div class="hang" aria-hidden="true">
          {heroShots.map((src, i) => (
            <img src={src} alt="" width="390" height="844" style={`--k: ${i}`} loading={i < 3 ? 'eager' : 'lazy'} />
          ))}
        </div>
      ) : (
        <img class="hero-cover" src={d.cover} alt={`${d.title} cover`} width="1600" height="1000" />
      )}
    </header>

    <!-- STORY -->
    <div class="container body">
      <aside class="meta">
        {d.outcome && (
          <div class="stat">
            <span class="label">What changed</span>
            <b>{d.outcome}</b>
          </div>
        )}
        <dl>
          {d.brand && (
            <div><dt class="label">Brand</dt><dd><i class="swatch"></i>{d.brand.toUpperCase()}</dd></div>
          )}
          {meta.map(([k, v]) => (
            <div><dt class="label">{k}</dt><dd>{v}</dd></div>
          ))}
        </dl>
        {links.length > 0 && (
          <div class="links">
            {links.map(([k, v]) => <a class="btn sm" href={v} target="_blank" rel="noopener">{k} ↗</a>)}
          </div>
        )}
      </aside>
      <div class="prose">
        <Content />
      </div>
    </div>

    <!-- SCREENS AS FLOWS -->
    {groups.length > 0 && (
      <section class="screens">
        <div class="container">
          <div class="section-head">
            <div class="screens-head">
              <span class="label">[ Screens ]</span>
              <h2>Final UI<span class="dot">.</span></h2>
            </div>
            <span class="label">{screenCount} screens · tap to enlarge</span>
          </div>
          {groups.map((group) => (
            <div class="group">
              <div class="group-head">
                <span class="label">[ {pad(group.items.length)} screens ]</span>
                <h3>{group.title}</h3>
                {group.note && <p>{group.note}</p>}
              </div>
              <ol class="strip">
                {group.items.map(({ src, i }, k) => (
                  <li>
                    {k > 0 && <span class="arrow" aria-hidden="true">→</span>}
                    <button type="button" class={`phone k-${kind(src)}`} data-i={i} data-src={src} data-kind={kind(src)} aria-label={`Enlarge ${group.title} screen ${k + 1}`}>
                      <img src={src} alt={`${d.title}: ${group.title} screen ${k + 1}`} loading="lazy" decoding="async" width="390" height="844" />
                    </button>
                  </li>
                ))}
              </ol>
            </div>
          ))}
        </div>
      </section>
    )}

    <dialog class="lightbox" aria-label="Screen preview">
      <img alt="" />
      <div class="lb-bar">
        <button type="button" class="lb-prev" aria-label="Previous screen">←</button>
        <span class="lb-count label"></span>
        <button type="button" class="lb-next" aria-label="Next screen">→</button>
        <button type="button" class="lb-close" aria-label="Close">×</button>
      </div>
    </dialog>

    <!-- NEXT PROJECT -->
    {next && next.id !== project.id && (
      <a class="next container" href={`/work/${next.id}/`} style={brandStyle(next.data.brand)}>
        <span class="next-band" style={`view-transition-name: plate-${vtName(next.id)}`}></span>
        <span class="label">Next project →</span>
        <span class="next-title">{next.data.title}</span>
        <span class="next-sum">{next.data.summary}</span>
      </a>
    )}
  </article>
</Base>

<script>
  const box = document.querySelector<HTMLDialogElement>('.lightbox');
  const img = box?.querySelector('img');
  const count = box?.querySelector('.lb-count');
  const phones = [...document.querySelectorAll<HTMLButtonElement>('.phone')];
  let current = 0;

  const show = (i: number) => {
    if (!img || !count) return;
    current = (i + phones.length) % phones.length;
    const btn = phones[current];
    img.src = btn.dataset.src ?? '';
    if (box) {
      box.dataset.kind = btn.dataset.kind ?? 'm';
      box.scrollTop = 0;
    }
    img.alt = btn.querySelector('img')?.alt ?? '';
    count.textContent = `${current + 1} / ${phones.length}`;
  };

  phones.forEach((btn, i) =>
    btn.addEventListener('click', () => {
      if (!box) return;
      const open = () => { show(i); box.showModal(); };
      const doc = document as Document & { startViewTransition?: (cb: () => void) => unknown };
      if (doc.startViewTransition && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
        const thumb = btn.querySelector('img') as HTMLImageElement;
        thumb.style.viewTransitionName = 'lb-shot';
        doc.startViewTransition(() => {
          thumb.style.viewTransitionName = '';
          if (img) img.style.viewTransitionName = 'lb-shot';
          open();
        });
      } else open();
    })
  );
  box?.querySelector('.lb-prev')?.addEventListener('click', () => show(current - 1));
  box?.querySelector('.lb-next')?.addEventListener('click', () => show(current + 1));
  box?.querySelector('.lb-close')?.addEventListener('click', () => box.close());
  box?.addEventListener('click', (e) => { if (e.target === box) box.close(); });
  box?.addEventListener('close', () => { if (img) img.style.viewTransitionName = ''; });
  box?.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowLeft') show(current - 1);
    if (e.key === 'ArrowRight') show(current + 1);
  });
</script>

<style>
  /* Hero band */
  .hero { position: relative; margin-top: 24px; padding-bottom: 0; }
  .band { position: absolute; inset: 0 var(--gutter) 160px; background: var(--brand); border-radius: 28px; z-index: -1; }
  .band-content {
    position: relative; color: var(--on-brand);
    display: flex; flex-direction: column; gap: 18px; align-items: flex-start;
    padding: clamp(32px, 6vw, 80px) clamp(28px, 5vw, 72px) clamp(32px, 4vw, 48px);
  }
  .band-content .label { color: var(--on-brand-2); }
  .back { text-decoration: none; }
  .back:hover { color: var(--on-brand); }
  h1 { font-size: clamp(44px, 8vw, 104px); font-weight: 800; letter-spacing: -0.035em; line-height: 0.95; max-width: 14ch; }
  h1 span { display: inline-block; }
  .summary { font-size: clamp(18px, 1.8vw, 22px); color: var(--on-brand-2); max-width: 46ch; }
  .btags { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 6px; }
  .btags li { font-size: 12px; font-weight: 500; padding: 5px 11px; border-radius: 999px; border: 1px solid color-mix(in srgb, var(--on-brand) 45%, transparent); }

  .hang { position: relative; display: flex; justify-content: center; gap: clamp(10px, 2vw, 24px); padding-inline: clamp(28px, 5vw, 72px); }
  .hang img {
    width: min(18%, 220px); aspect-ratio: 390 / 844; object-fit: cover; object-position: top;
    border-radius: 22px; box-shadow: 0 0 0 1px rgb(0 0 0 / .06), 0 30px 60px -28px rgb(0 0 0 / .45);
  }
  .hang img:nth-child(odd) { margin-top: 48px; }
  .hero-cover { width: calc(100% - 2 * clamp(28px, 5vw, 72px)); margin-inline: auto; border-radius: 20px; }

  @media (prefers-reduced-motion: no-preference) {
    .hang img { animation: rise .8s var(--ease) both; animation-delay: calc(150ms + var(--k) * 70ms); }
    @keyframes rise { from { opacity: 0; translate: 0 48px; } }
  }

  /* Story */
  .body { display: grid; grid-template-columns: 280px minmax(0, 1fr); gap: clamp(32px, 6vw, 96px); padding-block: clamp(56px, 8vw, 112px); align-items: start; }
  .meta { position: sticky; top: 96px; display: flex; flex-direction: column; gap: 24px; }
  .stat { display: flex; flex-direction: column; gap: 8px; padding: 20px; border-radius: 16px; background: var(--brand); color: var(--on-brand); }
  .stat .label { color: var(--on-brand-2); }
  .stat b { font-family: var(--display); font-size: 26px; line-height: 1.1; letter-spacing: -0.02em; }
  dl { margin: 0; display: flex; flex-direction: column; }
  dl div { padding-block: 12px; border-top: 1px solid var(--line); display: flex; flex-direction: column; gap: 2px; }
  dd { margin: 0; font-weight: 600; display: flex; align-items: center; gap: 8px; }
  .swatch { width: 14px; height: 14px; border-radius: 4px; background: var(--brand); }
  .links { display: flex; flex-wrap: wrap; gap: 8px; }

  .prose { max-width: 720px; font-size: 18px; }
  .prose :global(h2) { font-size: clamp(28px, 3.4vw, 40px); font-weight: 700; margin: 2.2em 0 0.6em; }
  .prose :global(h2:first-child) { margin-top: 0; }
  .prose :global(h3) { font-size: 22px; font-weight: 700; margin: 1.6em 0 0.5em; }
  .prose :global(p), .prose :global(ul), .prose :global(ol) { margin: 0 0 1.1em; color: var(--muted); }
  .prose :global(strong) { color: var(--ink); }
  .prose :global(img) { width: 100%; border-radius: 14px; margin: 1.6em 0; }
  .prose :global(blockquote) { margin: 0 0 2em; padding: 14px 18px; border-left: 3px solid var(--brand); background: color-mix(in oklab, var(--brand) 7%, var(--bg)); border-radius: 0 12px 12px 0; font-size: 15px; }
  .prose :global(blockquote p) { margin: 0; }

  /* Screens as flows */
  .screens { background: color-mix(in oklab, var(--brand) 6%, var(--bg)); border-block: 1px solid var(--line); padding-block: clamp(64px, 9vw, 120px); }
  .screens-head { display: flex; flex-direction: column; gap: 12px; }
  .group { display: flex; flex-direction: column; gap: 24px; padding-block: 40px; border-top: 1px solid var(--line); }
  .group-head { display: flex; flex-direction: column; gap: 6px; max-width: 60ch; }
  .group-head h3 { font-size: 26px; font-weight: 700; }
  .group-head p { color: var(--muted); font-size: 15px; }
  .strip {
    list-style: none; margin: 0; padding: 4px 4px 20px; display: flex; gap: 0; align-items: center;
    overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: thin;
  }
  .strip li { display: flex; align-items: center; flex: none; scroll-snap-align: start; }
  .arrow { width: 44px; text-align: center; color: var(--muted); font-size: 20px; }
  .phone { padding: 0; border: 0; background: none; cursor: zoom-in; border-radius: 24px; flex: none; width: 210px; transition: translate .4s var(--ease); }
  .phone:hover { translate: 0 -4px; }
  .phone img { width: 100%; aspect-ratio: 390 / 844; object-fit: cover; object-position: top; border-radius: 24px; box-shadow: 0 0 0 1px var(--line), 0 18px 40px -22px rgb(0 0 0 / .35); }

  /* Lightbox */
  /* Web and tablet screens in the strip: wider frames, top of the page */
  .phone.k-w { width: 560px; border-radius: 14px; }
  .phone.k-w img { aspect-ratio: 16 / 10; border-radius: 14px; }
  .phone.k-t { width: 340px; border-radius: 18px; }
  .phone.k-t img { aspect-ratio: 3 / 4; border-radius: 18px; }
  .lightbox[data-kind='w'], .lightbox[data-kind='t'] { max-width: min(94vw, 1200px); max-height: 92vh; overflow-y: auto; border-radius: 16px; }
  .lightbox[data-kind='t'] { max-width: min(94vw, 760px); }
  .lightbox[data-kind='w'] img, .lightbox[data-kind='t'] img { max-height: none; width: 100%; border-radius: 16px; }
  .lightbox[data-kind='w'] .lb-bar, .lightbox[data-kind='t'] .lb-bar { position: sticky; bottom: 12px; }

  /* Hero for web projects */
  .hang.web { align-items: flex-end; gap: clamp(12px, 2vw, 28px); }
  .hb { width: min(64%, 860px); border-radius: 16px; overflow: hidden; background: #FFFFFF; box-shadow: 0 0 0 1px rgb(0 0 0 / .06), 0 30px 60px -28px rgb(0 0 0 / .45); }
  .hb-bar { display: flex; gap: 6px; padding: 12px 14px; border-bottom: 1px solid #EFEAE3; }
  .hb-bar i { width: 9px; height: 9px; border-radius: 50%; background: #E7E1D8; }
  .hb img { width: 100%; aspect-ratio: 16 / 10; object-fit: cover; object-position: top; display: block; }
  .hang.web .hp { width: min(14%, 190px); margin-top: 0; margin-bottom: -24px; }
  .hang.web .hb, .hang.web .hp { animation: rise .8s var(--ease) both; animation-delay: calc(150ms + var(--k) * 90ms); }
  @media (prefers-reduced-motion: reduce) { .hang.web .hb, .hang.web .hp { animation: none; } }

  .lightbox { border: 0; padding: 0; background: transparent; max-width: min(92vw, 430px); max-height: 94vh; overflow: visible; }
  .lightbox::backdrop { background: rgb(10 10 10 / .82); backdrop-filter: blur(4px); }
  .lightbox img { max-height: 82vh; width: auto; border-radius: 28px; margin-inline: auto; }
  .lb-bar { display: flex; justify-content: center; align-items: center; gap: 12px; margin-top: 14px; }
  .lb-bar button { width: 42px; height: 42px; border-radius: 50%; border: 0; background: #FAF7F2; color: #1A1A1A; font-size: 20px; cursor: pointer; }
  .lb-count { color: #FAF7F2; min-width: 64px; text-align: center; }
  .lb-close { margin-left: 12px; }

  /* Next project */
  .next { position: relative; display: flex; flex-direction: column; gap: 10px; text-decoration: none; color: var(--on-brand); padding: clamp(48px, 7vw, 96px) clamp(28px, 5vw, 72px); margin-block: clamp(48px, 7vw, 96px); isolation: isolate; }
  .next-band { position: absolute; inset: 0 var(--gutter); background: var(--brand); border-radius: 28px; z-index: -1; transition: inset .5s var(--ease); }
  .next:hover .next-band { inset: -6px calc(var(--gutter) - 6px); }
  .next .label { color: var(--on-brand-2); }
  .next-title { font-family: var(--display); font-size: clamp(40px, 7vw, 88px); font-weight: 800; letter-spacing: -0.035em; line-height: 1; }
  .next-sum { color: var(--on-brand-2); max-width: 50ch; }

  @media (prefers-color-scheme: dark) {
    .band, .next-band, .stat { background: color-mix(in oklab, var(--brand) 88%, #000); }
  }

  @media (max-width: 860px) {
    .band { inset: 0 var(--gutter) 90px; border-radius: 20px; }
    .hang img { width: 30%; border-radius: 14px; }
    .hang img:nth-child(n + 4) { display: none; }
    .body { grid-template-columns: 1fr; }
    .meta { position: static; }
    .phone { width: 64vw; max-width: 260px; }
    .phone.k-w { width: 82vw; max-width: none; }
    .phone.k-t { width: 70vw; max-width: none; }
    .hb { width: 72%; }
    .hang.web .hp { width: 22%; }
    .arrow { width: 28px; }
    .next-band { border-radius: 20px; }
  }
</style>
